{
  "name": "@bg/site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "css:build": "tailwindcss -c tailwind.config.js -i ./styles/tailwind.css -o ./public/assets/tailwind.css --minify",
    "dev": "bun run css:build && bun --hot server.ts",
    "start": "bun run css:build && bun server.ts",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.84",
    "@bg/core": "workspace:*",
    "ai": "^7.0.128",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bun": "^1.3.13",
    "bun-types": "^1.3.12",
    "tailwindcss": "^3.4",
    "typescript": "^5.8.3"
  }
}
